# .env de produção. No servidor fica em ~/promocoes-shared/.env com permissão 600 (chmod 600).
# Troque tudo o que está em MAIÚSCULAS. Nunca faça commit deste arquivo preenchido.

APP_NAME="Promoções 321"
APP_ENV=production
# Gere no PC com: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://SEU-SUBDOMINIO

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Um arquivo de log por dia, guardados por 14 dias (não enche o disco da hospedagem).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Banco e usuário exclusivos, criados em cPanel > Bancos de dados MySQL (o cPanel prefixa os nomes).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=USUARIOCPANEL_promocoes
DB_USERNAME=USUARIOCPANEL_promocoes
DB_PASSWORD="SENHA_DO_BANCO"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sessão só trafega por HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Caixa nao-responda@ criada no Titan (e-mail do domínio na HostGator). SPF e DKIM do Titan já estão no DNS.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.titan.email
MAIL_PORT=465
MAIL_USERNAME=nao-responda@SEU-DOMINIO
MAIL_PASSWORD="SENHA_DO_EMAIL"
MAIL_FROM_ADDRESS="nao-responda@SEU-DOMINIO"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

ORGANIZER_NAME=
ORGANIZER_DOCUMENT=
ORGANIZER_CITY=
CONTACT_EMAIL=
CONTACT_WHATSAPP=

# Primeiro sandbox no servidor; production só depois do checklist de publicação (README).
# Aspas simples: a chave começa com $.
ASAAS_ENV=sandbox
ASAAS_API_KEY='$aact_...'
# Mesmo valor gerado em Asaas > Integrações > Webhooks > Gerar Token.
ASAAS_WEBHOOK_TOKEN=''
